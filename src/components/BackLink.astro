---
const { href = '/', label = '← Back' } = Astro.props;
---

<a href={href} data-astro-prefetch>{label}</a>

<style>
	a {
		color: var(--color-muted);
		font-size: var(--font-size-small);
		text-decoration: none;
		user-select: none;
		-webkit-user-drag: none;
	}

	a:hover {
		color: var(--color-body);
	}
</style>
