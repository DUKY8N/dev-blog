---
const { title } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const prompt = `"${title}" 글을 읽고 설명해 주세요.
${pageUrl}

- 핵심을 먼저 요약해 주세요.
- 너무 길지 않게 설명해 주세요.
- 처음 접하는 사람도 이해할 수 있게 설명해 주세요.`;

const href = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
---

<a href={href} target="_blank" rel="noopener noreferrer" title="Claude에게 물어보기" aria-label="Claude에게 물어보기">
	<span aria-hidden="true"></span>
</a>

<style>
	a {
		color: var(--color-muted);
		font-size: var(--font-size-small);
		position: relative;
	}

	a::after {
		content: '';
		position: absolute;
		inset: calc(-1 * var(--space-2));
	}

	@media (hover: hover) {
		a:hover {
			color: var(--color-body);
		}
	}

	span {
		display: inline-block;
		vertical-align: middle;
		width: 1em;
		height: 1em;
		background-color: currentColor;
		forced-color-adjust: none;
		mask: url('https://cdn.simpleicons.org/claude') center / contain no-repeat;
	}
</style>
